TAP_USERNAME=your_tap_username
TAP_PASSWORD=your_tap_password
TAP_ACCOUNT_NAME=ACME RETAIL LLC
HEADLESS=false

# --- the staging workbook ---------------------------------------------------
# It lives in the owner's OneDrive so every machine writes ONE copy and the owner
# can open it from a bookmark. Set ONE of the two locators below; the workbook is
# modified in place (a backup of the pre-edit copy lands in backups/ first).
#
# IMPORTANT: the owner must keep the workbook in Excel Online's VIEWING mode.
# Editing mode holds a lock and OneDrive then rejects every write with 423. The
# sync retries for about a minute and then gives up with a message saying so.
# Viewing mode takes no lock and copy/paste out of it works exactly the same.
#
# Path from the drive root. Preferred: it creates no sharing surface at all.
# `python onedrive.py info` prints this exactly, read off the file itself.
ONEDRIVE_FILE_PATH=Documents/Jasco/Order.xlsx
# Or a share link (Share → Copy link). Wins over the path if both are set. Check
# its audience first — "Anyone with the link" is a public, editable URL to a
# workbook full of business data.
# ONEDRIVE_SHARE_LINK=https://1drv.ms/x/...
#
# The app registration used to sign in. See "Setting up OneDrive access" in the
# README — it needs delegated Files.ReadWrite and public-client flows enabled.
GRAPH_CLIENT_ID=your_app_registration_client_id
# 'common' (default) accepts a work/school OR personal account. Use 'consumers'
# to force a personal account, or a tenant GUID to pin one organisation.
# GRAPH_AUTHORITY=https://login.microsoftonline.com/common
# Where the refresh token is cached. Defaults to .graph_token_cache.json in the
# repo root; each machine has its own and signs in once.
# GRAPH_TOKEN_CACHE=/path/to/.graph_token_cache.json

# Local-file mode: used ONLY when neither ONEDRIVE_* variable above is set. Handy
# for testing a change against a throwaway copy instead of the real workbook.
# ORDER_XLSX_PATH=/absolute/path/to/Master/Order.xlsx

# --- server deployment only -------------------------------------------------
# Both optional; leave them unset on a desktop/picker machine.

# Path to the single-instance lock file. The default is .lock in the repo root,
# which is all a lone deployment needs. Point it at ANOTHER project's lock file
# when something else drives the same Chromium profile — sharing one lock is
# what stops the two from ever running at once and corrupting that profile.
# TAP_LOCK=/path/to/other-project/.lock

# Telegram ping on a successful append or a crash. Both halves must be set or
# notify() stays a silent no-op (and `requests` is never imported). Worth having
# on an unattended run, where nobody is watching stdout.
# TG_BOT_TOKEN=your_bot_token
# TG_CHAT_ID=your_chat_id

# Extra recipients, numbered _2 upward to _9 (MAX_ACCOUNTS in telegram.py). Set
# both halves of a pair and every message goes there too.
#
# The whole range is scanned rather than stopping at the first gap, so the
# numbering does not have to be contiguous — configuring only _4 and leaving _2
# and _3 unset works. That is deliberate: it lets a recipient keep the same
# number here as in a sibling project's .env, so "the 4th chat" means one person
# across both.
# TG_BOT_TOKEN_2=your_bot_token
# TG_CHAT_ID_2=your_chat_id
