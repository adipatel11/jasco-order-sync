TAP_USERNAME=your_tap_username
TAP_PASSWORD=your_tap_password
TAP_ACCOUNT_NAME=ACME RETAIL LLC
# The master workbook, modified IN PLACE (a backup is saved to backups/ first).
# For local testing point this at the repo's Master/Order.xlsx.
ORDER_XLSX_PATH=/absolute/path/to/Master/Order.xlsx
HEADLESS=false

# --- server deployment only -------------------------------------------------
# Both optional; leave them unset on a desktop/picker machine.

# Path to the single-instance lock file. The default is .lock in the repo root,
# which is all a lone deployment needs. Point it at ANOTHER project's lock file
# when something else drives the same Chromium profile — sharing one lock is
# what stops the two from ever running at once and corrupting that profile.
# TAP_LOCK=/path/to/other-project/.lock

# Telegram ping on a successful append or a crash. Both halves must be set or
# notify() stays a silent no-op (and `requests` is never imported). Worth having
# on an unattended run, where nobody is watching stdout.
# TG_BOT_TOKEN=your_bot_token
# TG_CHAT_ID=your_chat_id
